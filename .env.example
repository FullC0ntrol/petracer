# Konfiguracja docker-compose.yml dla serwera VPS.
# Skopiuj do pliku .env (cp .env.example .env) i uzupełnij. Plik .env NIGDY nie trafia do repozytorium.
# Lokalnie (docker compose up na komputerze) plik .env nie jest potrzebny — działają wartości domyślne.

# Domena, pod którą działa aplikacja. Caddy pobierze dla niej certyfikat HTTPS.
# Rekord DNS typu A domeny musi wskazywać na adres IP serwera (DEPLOY.md, krok 2).
SITE_ADDRESS=petracker.pl

# Pełny publiczny adres aplikacji — z niego budowane są linki logowania w mailach.
APP_URL=https://petracker.pl

# Porty Caddy na serwerze. Do automatycznego HTTPS muszą być standardowe 80 i 443.
HTTP_PORT=80
HTTPS_PORT=443

# Hasło do bazy danych. Tylko litery i cyfry (trafia do adresu połączenia), wygeneruj:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Sekret do podpisywania sesji. Długi i losowy; jego zmiana wyloguje wszystkich. Wygeneruj:
#   openssl rand -hex 32
JWT_SECRET=

# true = wczytaj dane przykładowe (Luna, Mruczek, konto maciej@pettrace.pl) do pustej bazy.
# Na prawdziwym serwerze zostaw false.
SEED_DEMO_DATA=false

# Ciasteczko sesji tylko przez HTTPS. Na serwerze zawsze true.
COOKIE_SECURE=true

# Poczta wychodząca (SMTP) do wysyłki linków logowania. Dane podaje dostawca poczty.
# Puste SMTP_HOST = link logowania nie jest wysyłany, tylko wypisywany w logach:
#   docker compose logs api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PetTrace <no-reply@petracker.pl>
