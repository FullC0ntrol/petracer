# Konfiguracja API do pracy lokalnej. Skopiuj do server/.env:  cp .env.example .env
# Bez pliku .env serwer też wystartuje (w trybie dev ma wartości domyślne takie jak niżej).

# Tryb pracy: development albo production.
NODE_ENV=development

# Port, na którym nasłuchuje API. Vite przekierowuje do niego adresy /api (vite.config.js).
PORT=3000

# Połączenie z bazą: postgres://użytkownik:hasło@host:port/nazwa_bazy
# Pasuje do bazy z docker-compose.dev.yml.
DATABASE_URL=postgres://petrace:petrace@localhost:5434/petrace

# Sekret do podpisywania sesji (JWT). W produkcji długi, losowy napis:  openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me

# Publiczny adres frontendu. Serwer rozpoznaje po nim, czy działa lokalnie.
APP_URL=http://localhost:5173

# true = przy starcie wczytaj dane przykładowe (Luna, Mruczek), jeśli baza jest pusta.
SEED_DEMO_DATA=true

# Przycisk „Wejdź na konto demo” na stronie logowania. Puste = włączony tylko na localhost.
DEMO_LOGIN=

# Ciasteczko sesji tylko przez HTTPS. Puste = automatycznie (true w produkcji).
COOKIE_SECURE=
